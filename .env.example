# ===== Servidor =====
PORT=3000
# Orígenes permitidos para CORS separados por coma (vacío = todos)
CORS_ORIGIN=

# ===== JWT =====
# Cadena larga y aleatoria. Generala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=COMPLETAR
JWT_EXPIRES_IN=1h

# ===== Usuario habilitado para el login =====
AUTH_USER_EMAIL=admin@techlab.com
AUTH_USER_PASSWORD=COMPLETAR

# ===== Firebase (Consola > Configuración del proyecto > Tus apps > App web) =====
FIREBASE_API_KEY=COMPLETAR
FIREBASE_AUTH_DOMAIN=COMPLETAR.firebaseapp.com
FIREBASE_PROJECT_ID=COMPLETAR
FIREBASE_STORAGE_BUCKET=COMPLETAR.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=COMPLETAR
FIREBASE_APP_ID=COMPLETAR

# Nombre de la colección en Firestore
FIRESTORE_COLLECTION=products
# Tiempo máximo de espera a Firestore (ms) antes de responder 500
DB_TIMEOUT_MS=8000
